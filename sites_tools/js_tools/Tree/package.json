{
  "name": "@jaisocx/tree",
  "version": "2.2.21",
  "description": "Sites tool, styling json",
  "author": "Jaisocx Company",
  "keywords": [
    "json",
    "tree"
  ],
  "files": [
    "favicon/",
    "software_labels/",

    "README.md",
    "webpack.aliases.json",

    "index.preview.html",
    "tree_preview_prod.html",

    "data/",

    "MediaAndStyles/*.css",
    "MediaAndStyles/presets/",
    "MediaAndStyles/themes/theme-funny/",
    "MediaAndStyles/themes/theme_base/",

    "transpiled/CommonJS",
    "transpiled/ESNext",
    "transpiled/Simple"
  ],
  "dependencies": {
    "@jaisocx/event-emitter": "~1.4.3",
    "@jaisocx/jpath": "~1.2.3",
    "@jaisocx/template-renderer": "~1.6.2"
  },
  "optionalDependencies": {
    "@jaisocx/css_clean_start_lite": "^1.0.3",
    "@jaisocx/preloader": "~2.3.2",
    "@jaisocx/theme-turn-on": "~1.0.4"
  },
  "type": "module",
  "main": "./transpiled/CommonJS/index.js",
  "types": "./transpiled/ESNext/index.d.ts",
  "module": "./transpiled/ESNext/index.js",
  "exports": {
    ".": {
      "import": "./transpiled/ESNext/index.js",
      "require": "./transpiled/CommonJS/index.js"
    },
    "./WebpackAliases": {
      "import": "./transpiled/ESNext/webpack.aliases.mjs",
      "require": "./transpiled/CommonJS/webpack.aliases.cjs"
    }
  },
  "private": false,
  "publishConfig": {
    "access": "public"
  }
}


