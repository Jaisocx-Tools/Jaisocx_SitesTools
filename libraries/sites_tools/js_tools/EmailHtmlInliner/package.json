    "inline",
    "css",
    "styles",
    "html",
    "email"
  ],
  "files": [
    "README.md",
    "webpack.aliases.json",

    "transpiled/CommonJS/",
    "transpiled/ESNext/",
    "transpiled/Simple/"
  ],
  "optionalDependencies": {
